rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function myDoc() { return userDoc(request.auth.uid); }
    function myRole() {
      return signedIn() && exists(myDoc()) ? get(myDoc()).data.role : 'user';
    }
    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }
    function isMentor() {
      return signedIn() && (myRole() == 'mentor' || isAdmin());
    }
    function isAssignedMentor(uid) {
      return isMentor()
        && exists(userDoc(uid))
        && get(userDoc(uid)).data.mentorIds is list
        && get(userDoc(uid)).data.mentorIds.hasAny([request.auth.uid]);
    }
    function canReadPrivate(uid) {
      return isOwner(uid) || isAdmin() || isAssignedMentor(uid);
    }

    function validRole(role) {
      return role in ['user', 'mentor', 'admin'];
    }
    function validUser(uid, data) {
      return data.keys().hasAll([
          'uid', 'email', 'role', 'mentorIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'role', 'mentorIds', 'createdAt', 'updatedAt',
          'lastAdminActionId'
        ])
        && data.uid == uid
        && data.email is string && data.email.size() > 2 && data.email.size() <= 254
        && validRole(data.role)
        && data.mentorIds is list && data.mentorIds.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('lastAdminActionId' in data)
          || (data.lastAdminActionId is string && data.lastAdminActionId.size() <= 128));
    }
    function isLegacyUser() {
      return resource.data.keys().hasAny(['profile', 'progress']);
    }
    function preservesLegacyAccess(data) {
      return data.role == (('role' in resource.data) ? resource.data.role : 'user')
        && data.mentorIds == (('mentorIds' in resource.data) ? resource.data.mentorIds : []);
    }
    function validOwnerUpdate(uid) {
      return validUser(uid, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.mentorIds == resource.data.mentorIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'updatedAt']);
    }
    function validAudit(data, targetUid) {
      return data.keys().hasAll([
          'actorUid', 'targetUid', 'action', 'role', 'mentorIds', 'at'
        ])
        && data.keys().hasOnly([
          'actorUid', 'targetUid', 'action', 'role', 'mentorIds', 'at'
        ])
        && data.actorUid == request.auth.uid
        && data.targetUid == targetUid
        && data.action == 'update-access'
        && validRole(data.role)
        && data.mentorIds is list && data.mentorIds.size() <= 50
        && data.at == request.time;
    }
    function hasMatchingAudit(uid) {
      let actionId = request.resource.data.lastAdminActionId;
      let audit = getAfter(/databases/$(database)/documents/adminAudit/$(actionId)).data;
      return request.resource.data.keys().hasAll(['lastAdminActionId'])
        && validAudit(audit, uid)
        && audit.role == request.resource.data.role
        && audit.mentorIds == request.resource.data.mentorIds;
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'fullName', 'careerGoalKey', 'careerGoalLabel', 'currentRole',
          'yearsExp', 'skillLevel', 'workStartMin', 'workEndMin',
          'learnStartMin', 'learnEndMin', 'afterStartMin', 'afterHours',
          'learningStyles', 'cloud', 'targetCert', 'timelineMonths',
          'interests', 'onboardedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fullName', 'careerGoalKey', 'careerGoalLabel', 'currentRole',
          'yearsExp', 'skillLevel', 'workStartMin', 'workEndMin',
          'learnStartMin', 'learnEndMin', 'afterStartMin', 'afterHours',
          'learningStyles', 'cloud', 'targetCert', 'timelineMonths',
          'interests', 'onboardedAt', 'updatedAt'
        ])
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.careerGoalKey in [
          'cloud-architect', 'ai-engineer', 'devops-engineer',
          'data-engineer', 'cybersecurity-engineer', 'backend-engineer'
        ]
        && data.careerGoalLabel is string && data.careerGoalLabel.size() <= 80
        && data.currentRole is string && data.currentRole.size() <= 100
        && data.yearsExp is int && data.yearsExp >= 0 && data.yearsExp <= 50
        && data.skillLevel in ['Beginner', 'Intermediate', 'Advanced']
        && data.workStartMin is int && data.workStartMin >= 0 && data.workStartMin < 1440
        && data.workEndMin is int && data.workEndMin > data.workStartMin && data.workEndMin < 1440
        && data.learnStartMin is int && data.learnStartMin >= 0 && data.learnStartMin < 1440
        && data.learnEndMin is int && data.learnEndMin >= data.learnStartMin + 40 && data.learnEndMin < 1440
        && data.afterStartMin is int && data.afterStartMin >= 0 && data.afterStartMin < 1440
        && data.afterHours is number && data.afterHours >= 0 && data.afterHours <= 6
        && data.learningStyles is list && data.learningStyles.size() <= 5
        && data.learningStyles.hasOnly([
          'Videos', 'Documentation', 'Hands-on Labs', 'Courses', 'Reading'
        ])
        && data.cloud in ['Azure', 'AWS', 'GCP']
        && data.targetCert is string && data.targetCert.size() <= 100
        && data.timelineMonths is int && data.timelineMonths >= 1 && data.timelineMonths <= 36
        && data.interests is list && data.interests.size() <= 20
        && data.onboardedAt is string && data.onboardedAt.size() <= 40
        && data.updatedAt is timestamp;
    }
    function validLegacyPlan(data) {
      return data.keys().hasAll(['careerGoalKey', 'cloud', 'templateVersion', 'updatedAt'])
        && data.keys().hasOnly(['careerGoalKey', 'cloud', 'templateVersion', 'updatedAt'])
        && data.careerGoalKey in [
          'cloud-architect', 'ai-engineer', 'devops-engineer',
          'data-engineer', 'cybersecurity-engineer', 'backend-engineer'
        ]
        && data.cloud in ['Azure', 'AWS', 'GCP']
        && data.templateVersion is int && data.templateVersion >= 1
        && data.updatedAt is timestamp;
    }
    function validPlan(planId, data) {
      return data.keys().hasAll([
          'schemaVersion', 'planId', 'templateId', 'templateVersion',
          'careerGoalKey', 'cloud', 'activeRevisionId',
          'latestRevisionNumber', 'status', 'sourceHash',
          'migrationSource', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'planId', 'templateId', 'templateVersion',
          'careerGoalKey', 'cloud', 'activeRevisionId',
          'latestRevisionNumber', 'status', 'sourceHash',
          'migrationSource', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 2
        && data.planId == planId
        && data.planId is string && data.planId.size() > 0 && data.planId.size() <= 128
        && data.templateId is string && data.templateId.size() > 0 && data.templateId.size() <= 128
        && data.templateVersion is int && data.templateVersion >= 1
        && data.careerGoalKey in [
          'cloud-architect', 'ai-engineer', 'devops-engineer',
          'data-engineer', 'cybersecurity-engineer', 'backend-engineer'
        ]
        && data.cloud in ['Azure', 'AWS', 'GCP']
        && data.activeRevisionId is string && data.activeRevisionId.size() <= 32
        && data.latestRevisionNumber is int
        && data.latestRevisionNumber >= 1 && data.latestRevisionNumber <= 10000
        && data.status in ['active', 'archived']
        && data.sourceHash is string && data.sourceHash.size() > 0 && data.sourceHash.size() <= 64
        && data.migrationSource in ['new-plan', 'legacy-active', 'template-update', 'rollback']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    function validRevision(planId, revisionId, data) {
      return data.keys().hasAll([
          'planId', 'revisionId', 'revisionNumber', 'previousRevisionId',
          'restoredRevisionId', 'reason', 'templateId', 'templateVersion',
          'sourceHash', 'taskIds', 'sessionIds', 'chunkIds',
          'preservedCompletedTaskIds', 'createdAt'
        ])
        && data.keys().hasOnly([
          'planId', 'revisionId', 'revisionNumber', 'previousRevisionId',
          'restoredRevisionId', 'reason', 'templateId', 'templateVersion',
          'sourceHash', 'taskIds', 'sessionIds', 'chunkIds',
          'preservedCompletedTaskIds', 'createdAt'
        ])
        && data.planId == planId
        && data.revisionId == revisionId
        && data.revisionNumber is int
        && data.revisionNumber >= 1 && data.revisionNumber <= 10000
        && ((data.revisionNumber == 1 && data.previousRevisionId == null)
          || (data.revisionNumber > 1
            && data.previousRevisionId is string
            && data.previousRevisionId.size() <= 32))
        && data.reason in [
          'initial-generation', 'legacy-migration', 'profile-change',
          'template-update', 'rollback'
        ]
        && ((data.reason == 'rollback'
            && data.revisionNumber > 1
            && data.restoredRevisionId is string
            && data.restoredRevisionId.size() <= 32)
          || (data.reason != 'rollback' && data.restoredRevisionId == null))
        && data.templateId is string && data.templateId.size() <= 128
        && data.templateVersion is int && data.templateVersion >= 1
        && data.sourceHash is string && data.sourceHash.size() <= 64
        && data.taskIds is list
        && data.taskIds.size() > 0 && data.taskIds.size() <= 72
        && data.taskIds.toSet().size() == data.taskIds.size()
        && data.sessionIds is list
        && data.sessionIds.size() == data.taskIds.size()
        && data.sessionIds.toSet().size() == data.sessionIds.size()
        && data.chunkIds == [
          'chunk-000', 'chunk-001', 'chunk-002', 'chunk-003',
          'chunk-004', 'chunk-005', 'chunk-006', 'chunk-007',
          'chunk-008'
        ]
        && data.preservedCompletedTaskIds is list
        && data.preservedCompletedTaskIds.size() <= 72
        && data.taskIds.toSet().hasAll(data.preservedCompletedTaskIds.toSet())
        && data.createdAt is timestamp;
    }
    function chunkMetadataMatches(planId, revision, chunkId, ordinal, data) {
      return data.planId == planId
        && data.revisionId == revision.revisionId
        && data.chunkId == chunkId
        && data.ordinal == ordinal
        && data.sourceHash == revision.sourceHash;
    }
    function rollbackTargetMatches(uid, planId, revision) {
      let target = get(/databases/$(database)/documents/users/$(uid)/plans/$(planId)/revisions/$(revision.restoredRevisionId)).data;
      return revision.reason != 'rollback'
        || (target.planId == planId
          && target.revisionId == revision.restoredRevisionId
          && target.revisionNumber < revision.revisionNumber
          && target.templateId == revision.templateId
          && target.templateVersion == revision.templateVersion
          && target.sourceHash == revision.sourceHash
          && target.taskIds == revision.taskIds
          && target.sessionIds == revision.sessionIds
          && target.chunkIds == revision.chunkIds);
    }
    // Cross-document transaction checks are intentionally excluded here.
    // Firestore limits document-access calls across a batched plan creation.
    function validChunkEntry(data, index, revision) {
      let order = data.ordinal * 8 + index;
      return data.taskIds[index] is string
        && data.taskIds[index].size() > 0 && data.taskIds[index].size() <= 256
        && data.taskIds[index] == revision.taskIds[order]
        && data.templateTaskIds[index] is string
        && data.templateTaskIds[index].size() <= 256
        && data.titles[index] is string
        && data.titles[index].size() > 0 && data.titles[index].size() <= 500
        && data.phaseIds[index] is string && data.phaseIds[index].size() <= 80
        && data.phaseTitles[index] is string && data.phaseTitles[index].size() <= 160
        && ((order == 0 && data.dependencyIds[index] == null)
          || (order > 0 && data.dependencyIds[index] == revision.taskIds[order - 1]))
        && data.estimatedMinutes[index] is int
        && data.estimatedMinutes[index] >= 10
        && data.estimatedMinutes[index] <= 1440
        && data.sessionIds[index] is string
        && data.sessionIds[index] == revision.sessionIds[order]
        && data.sessionIds[index] == data.taskIds[index] + '::1'
        && data.statuses[index] in ['unscheduled', 'scheduled', 'completed', 'skipped']
        && data.locks[index] is bool
        && (data.scheduledDates[index] == null
          || (data.scheduledDates[index] is string
            && data.scheduledDates[index].size() == 10))
        && (data.startMinutes[index] == null
          || (data.startMinutes[index] is int
            && data.startMinutes[index] >= 0
            && data.startMinutes[index] < 1440))
        && data.durationMinutes[index] is int
        && data.durationMinutes[index] >= 10
        && data.durationMinutes[index] <= 1440;
    }
    function validChunkSize(ordinal, size, revisionSize) {
      return (revisionSize >= (ordinal + 1) * 8 && size == 8)
        || (revisionSize > ordinal * 8
          && revisionSize < (ordinal + 1) * 8
          && size == revisionSize - ordinal * 8)
        || (revisionSize <= ordinal * 8 && size == 0);
    }
    function chunkRestoresTarget(uid, planId, revision, chunkId, data) {
      let target = get(/databases/$(database)/documents/users/$(uid)/plans/$(planId)/revisions/$(revision.restoredRevisionId)/chunks/$(chunkId)).data;
      return data.diff(target).affectedKeys().hasOnly(['revisionId', 'createdAt']);
    }
    function validChunkEntries(data, revision) {
      return (data.taskIds.size() <= 0 || validChunkEntry(data, 0, revision))
        && (data.taskIds.size() <= 1 || validChunkEntry(data, 1, revision))
        && (data.taskIds.size() <= 2 || validChunkEntry(data, 2, revision))
        && (data.taskIds.size() <= 3 || validChunkEntry(data, 3, revision))
        && (data.taskIds.size() <= 4 || validChunkEntry(data, 4, revision))
        && (data.taskIds.size() <= 5 || validChunkEntry(data, 5, revision))
        && (data.taskIds.size() <= 6 || validChunkEntry(data, 6, revision))
        && (data.taskIds.size() <= 7 || validChunkEntry(data, 7, revision));
    }
    function validNewRevisionChunk(planId, revisionId, chunkId, data, revision) {
      return data.keys().hasOnly([
          'planId', 'revisionId', 'chunkId', 'ordinal', 'sourceHash',
          'taskIds', 'templateTaskIds', 'titles', 'phaseIds', 'phaseTitles',
          'dependencyIds', 'estimatedMinutes', 'sessionIds', 'statuses', 'locks',
          'scheduledDates', 'startMinutes', 'durationMinutes', 'createdAt'
        ])
        && data.planId == planId
        && data.revisionId == revisionId
        && data.chunkId == chunkId
        && data.ordinal is int && data.ordinal >= 0 && data.ordinal < 9
        && ((data.ordinal == 0 && chunkId == 'chunk-000')
          || (data.ordinal == 1 && chunkId == 'chunk-001')
          || (data.ordinal == 2 && chunkId == 'chunk-002')
          || (data.ordinal == 3 && chunkId == 'chunk-003')
          || (data.ordinal == 4 && chunkId == 'chunk-004')
          || (data.ordinal == 5 && chunkId == 'chunk-005')
          || (data.ordinal == 6 && chunkId == 'chunk-006')
          || (data.ordinal == 7 && chunkId == 'chunk-007')
          || (data.ordinal == 8 && chunkId == 'chunk-008'))
        && data.sourceHash == revision.sourceHash
        && data.taskIds is list && data.taskIds.size() <= 8
        && validChunkSize(data.ordinal, data.taskIds.size(), revision.taskIds.size())
        && data.templateTaskIds is list && data.templateTaskIds.size() == data.taskIds.size()
        && data.titles is list && data.titles.size() == data.taskIds.size()
        && !data.titles.hasAny([''])
        && data.phaseIds is list && data.phaseIds.size() == data.taskIds.size()
        && data.phaseTitles is list && data.phaseTitles.size() == data.taskIds.size()
        && data.dependencyIds is list && data.dependencyIds.size() == data.taskIds.size()
        && data.estimatedMinutes is list && data.estimatedMinutes.size() == data.taskIds.size()
        && data.sessionIds is list && data.sessionIds.size() == data.taskIds.size()
        && data.statuses is list && data.statuses.size() == data.taskIds.size()
        && data.locks is list && data.locks.size() == data.taskIds.size()
        && data.scheduledDates is list && data.scheduledDates.size() == data.taskIds.size()
        && data.startMinutes is list && data.startMinutes.size() == data.taskIds.size()
        && data.durationMinutes is list && data.durationMinutes.size() == data.taskIds.size()
        && validChunkEntries(data, revision)
        && data.createdAt is timestamp;
    }
    function validRevisionChunk(uid, planId, revisionId, chunkId, data) {
      return data.keys().hasOnly([
          'planId', 'revisionId', 'chunkId', 'ordinal', 'sourceHash',
          'taskIds', 'templateTaskIds', 'titles', 'phaseIds', 'phaseTitles',
          'dependencyIds', 'estimatedMinutes', 'sessionIds', 'statuses', 'locks',
          'scheduledDates', 'startMinutes', 'durationMinutes', 'createdAt'
        ])
        && data.planId == planId
        && data.revisionId == revisionId
        && data.chunkId == chunkId
        && data.ordinal is int && data.ordinal >= 0 && data.ordinal < 9
        && data.sourceHash is string && data.sourceHash.size() > 0 && data.sourceHash.size() <= 64
        && data.taskIds is list && data.taskIds.size() <= 8
        && data.templateTaskIds is list && data.templateTaskIds.size() == data.taskIds.size()
        && data.titles is list && data.titles.size() == data.taskIds.size() && !data.titles.hasAny([''])
        && data.phaseIds is list && data.phaseIds.size() == data.taskIds.size()
        && data.phaseTitles is list && data.phaseTitles.size() == data.taskIds.size()
        && data.dependencyIds is list && data.dependencyIds.size() == data.taskIds.size()
        && data.estimatedMinutes is list && data.estimatedMinutes.size() == data.taskIds.size()
        && data.sessionIds is list && data.sessionIds.size() == data.taskIds.size()
        && data.statuses is list && data.statuses.size() == data.taskIds.size()
        && data.locks is list && data.locks.size() == data.taskIds.size()
        && data.scheduledDates is list && data.scheduledDates.size() == data.taskIds.size()
        && data.startMinutes is list && data.startMinutes.size() == data.taskIds.size()
        && data.durationMinutes is list && data.durationMinutes.size() == data.taskIds.size()
        && data.createdAt is timestamp;
    }
    function validTask(taskId, data) {
      return data.keys().hasAll([
          'taskId', 'templateTaskId', 'title', 'phaseId', 'phaseTitle',
          'order', 'dependencyIds', 'estimatedMinutes', 'activeRevisionId',
          'definitionChunkId', 'definitionIndex', 'firstRevisionId', 'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'taskId', 'templateTaskId', 'title', 'phaseId', 'phaseTitle',
          'order', 'dependencyIds', 'estimatedMinutes', 'activeRevisionId',
          'definitionChunkId', 'definitionIndex', 'firstRevisionId', 'createdAt',
          'updatedAt'
        ])
        && data.taskId == taskId
        && data.taskId is string && data.taskId.size() > 0 && data.taskId.size() <= 256
        && data.templateTaskId is string && data.templateTaskId.size() <= 256
        && data.title is string && data.title.size() > 0 && data.title.size() <= 500
        && data.phaseId is string && data.phaseId.size() <= 80
        && data.phaseTitle is string && data.phaseTitle.size() <= 160
        && data.order is int && data.order >= 0 && data.order < 2000
        && data.dependencyIds is list && data.dependencyIds.size() <= 20
        && !data.dependencyIds.hasAny([data.taskId])
        && data.estimatedMinutes is int
        && data.estimatedMinutes >= 10 && data.estimatedMinutes <= 1440
        && data.activeRevisionId is string && data.activeRevisionId.size() <= 32
        && data.definitionChunkId is string && data.definitionChunkId.size() <= 16
        && data.definitionIndex is int
        && data.definitionIndex >= 0 && data.definitionIndex < 8
        && data.firstRevisionId is string && data.firstRevisionId.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    function validSession(sessionId, data) {
      return data.keys().hasAll([
          'sessionId', 'taskId', 'ordinal', 'status', 'locked',
          'scheduledDate', 'startMin', 'durationMin', 'activeRevisionId',
          'definitionChunkId', 'definitionIndex', 'firstRevisionId', 'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'sessionId', 'taskId', 'ordinal', 'status', 'locked',
          'scheduledDate', 'startMin', 'durationMin', 'activeRevisionId',
          'definitionChunkId', 'definitionIndex', 'firstRevisionId', 'createdAt',
          'updatedAt'
        ])
        && data.sessionId == sessionId
        && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 300
        && data.taskId is string && data.taskId.size() <= 256
        && data.ordinal is int && data.ordinal >= 1 && data.ordinal <= 100
        && data.status in ['unscheduled', 'scheduled', 'completed', 'skipped']
        && data.locked is bool
        && data.durationMin is int && data.durationMin >= 10 && data.durationMin <= 1440
        && (
          (data.scheduledDate == null && data.startMin == null)
          || (
            data.scheduledDate is string
            && data.scheduledDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && data.startMin is int && data.startMin >= 0 && data.startMin < 1440
            && data.startMin + data.durationMin <= 1440
          )
        )
        && (data.status != 'scheduled' || data.scheduledDate != null)
        && (data.status != 'unscheduled' || data.scheduledDate == null)
        && (!data.locked || data.status == 'scheduled')
        && data.activeRevisionId is string && data.activeRevisionId.size() <= 32
        && data.definitionChunkId is string && data.definitionChunkId.size() <= 16
        && data.definitionIndex is int
        && data.definitionIndex >= 0 && data.definitionIndex < 8
        && data.firstRevisionId is string && data.firstRevisionId.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    function validProgress(data) {
      return data.keys().hasAll(['done', 'streak', 'log', 'celebrated', 'updatedAt'])
        && data.keys().hasOnly(['done', 'streak', 'log', 'celebrated', 'updatedAt'])
        && data.done is list && data.done.size() <= 2000
        && data.streak is map
        && data.streak.keys().hasAll(['count', 'last'])
        && data.streak.keys().hasOnly(['count', 'last'])
        && data.streak.count is int && data.streak.count >= 0 && data.streak.count <= 10000
        && (data.streak.last == null
          || (data.streak.last is string && data.streak.last.size() == 10))
        && data.log is map && data.log.size() <= 2000
        && data.celebrated is list && data.celebrated.size() <= 100
        && data.updatedAt is timestamp;
    }
    function isIsoDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function validSettings(data) {
      return data.keys().hasAll(['weekTarget', 'updatedAt'])
        && data.keys().hasOnly([
          'weekTarget', 'activePlanId', 'planner', 'plannerVersion', 'updatedAt'
        ])
        && data.weekTarget is int && data.weekTarget >= 10 && data.weekTarget <= 10000
        && (!('activePlanId' in data)
          || (data.activePlanId is string && data.activePlanId.size() <= 128))
        && (!('plannerVersion' in data)
          || (data.plannerVersion is int
            && data.plannerVersion >= 0 && data.plannerVersion <= 1000000))
        && (!('planner' in data) || (
          data.planner is map
          && data.planner.keys().hasAll([
            'startDate', 'deadline', 'availableDays', 'startMin', 'endMin',
            'dailyCapMinutes', 'weeklyCapMinutes'
          ])
          && data.planner.keys().hasOnly([
            'startDate', 'deadline', 'availableDays', 'startMin', 'endMin',
            'dailyCapMinutes', 'weeklyCapMinutes'
          ])
          && isIsoDate(data.planner.startDate)
          && isIsoDate(data.planner.deadline)
          && data.planner.deadline >= data.planner.startDate
          && data.planner.availableDays is list
          && data.planner.availableDays.size() > 0
          && data.planner.availableDays.size() <= 7
          && data.planner.availableDays.toSet().size() == data.planner.availableDays.size()
          && data.planner.availableDays.toSet().hasOnly([0, 1, 2, 3, 4, 5, 6].toSet())
          && data.planner.startMin is int
          && data.planner.startMin >= 0 && data.planner.startMin <= 1430
          && data.planner.endMin is int
          && data.planner.endMin > data.planner.startMin && data.planner.endMin <= 1440
          && data.planner.dailyCapMinutes is int
          && data.planner.dailyCapMinutes >= 10
          && data.planner.dailyCapMinutes <= data.planner.endMin - data.planner.startMin
          && data.planner.weeklyCapMinutes is int
          && data.planner.weeklyCapMinutes >= data.planner.dailyCapMinutes
          && data.planner.weeklyCapMinutes <= 10080
        ))
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isAssignedMentor(uid);
      allow create: if isOwner(uid)
        && validUser(uid, request.resource.data)
        && request.resource.data.role == 'user'
        && request.resource.data.mentorIds.size() == 0;
      allow update: if isOwner(uid) && (
        validOwnerUpdate(uid)
        || (isLegacyUser()
          && validUser(uid, request.resource.data)
          && preservesLegacyAccess(request.resource.data))
      );
      allow update: if isAdmin()
        && validUser(uid, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'mentorIds', 'updatedAt', 'lastAdminActionId'])
        && hasMatchingAudit(uid);
      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if canReadPrivate(uid);
        allow create, update: if profileId == 'main' && isOwner(uid)
          && validProfile(request.resource.data);
        allow delete: if false;
      }

      match /plans/{planId} {
        allow read: if canReadPrivate(uid);
        allow create, update: if planId == 'active' && isOwner(uid)
          && validLegacyPlan(request.resource.data);
        // Plan creation shares a transaction with revisions, chunks, tasks, and sessions.
        // Validate the plan document here, but avoid cross-document getAfter checks:
        // those checks exceed Firestore's authorization access budget for a full plan write.
        allow create: if planId != 'active' && isOwner(uid)
          && validPlan(planId, request.resource.data)
          && request.resource.data.latestRevisionNumber == 1;
        allow update: if planId != 'active' && isOwner(uid)
          && validPlan(planId, request.resource.data)
          && request.resource.data.planId == resource.data.planId
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.templateId == resource.data.templateId
          && request.resource.data.careerGoalKey == resource.data.careerGoalKey
          && request.resource.data.cloud == resource.data.cloud
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.activeRevisionId != resource.data.activeRevisionId
          && request.resource.data.latestRevisionNumber == resource.data.latestRevisionNumber + 1;
        allow delete: if false;

        match /revisions/{revisionId} {
          allow read: if canReadPrivate(uid);
          // The parent plan and this revision are written atomically. Schema validation
          // is enforced here; referential checks stay off the write hot path to keep the
          // complete plan transaction within Firestore's document-access limits.
          allow create: if isOwner(uid)
            && validRevision(planId, revisionId, request.resource.data)
            && rollbackTargetMatches(uid, planId, request.resource.data);
          allow update, delete: if false;

          match /chunks/{chunkId} {
            allow read: if canReadPrivate(uid);
            allow create: if isOwner(uid)
              && validRevisionChunk(
                uid,
                planId,
                revisionId,
                chunkId,
                request.resource.data
              );
            allow update, delete: if false;
          }
        }

        match /tasks/{taskId} {
          allow read: if canReadPrivate(uid);
          allow create: if isOwner(uid)
            && validTask(taskId, request.resource.data);
          allow update: if isOwner(uid)
            && validTask(taskId, request.resource.data)
            && request.resource.data.taskId == resource.data.taskId
            && request.resource.data.templateTaskId == resource.data.templateTaskId
            && request.resource.data.firstRevisionId == resource.data.firstRevisionId
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if false;
        }

        match /sessions/{sessionId} {
          allow read: if canReadPrivate(uid);
          allow create: if isOwner(uid)
            && validSession(sessionId, request.resource.data);
          allow update: if isOwner(uid)
            && validSession(sessionId, request.resource.data)
            && request.resource.data.sessionId == resource.data.sessionId
            && request.resource.data.taskId == resource.data.taskId
            && request.resource.data.ordinal == resource.data.ordinal
            && request.resource.data.firstRevisionId == resource.data.firstRevisionId
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if false;
        }
      }

      match /taskProgress/{progressId} {
        allow read: if canReadPrivate(uid);
        allow create, update: if progressId == 'main' && isOwner(uid)
          && validProgress(request.resource.data);
        allow delete: if false;
      }

      match /settings/{settingsId} {
        allow read: if canReadPrivate(uid);
        allow create, update: if settingsId == 'main' && isOwner(uid)
          && validSettings(request.resource.data);
        allow delete: if false;
      }
    }

    match /adminAudit/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validAudit(request.resource.data, request.resource.data.targetUid);
      allow update, delete: if false;
    }

    match /broadcasts/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'body', 'at', 'byUid'])
        && request.resource.data.keys().hasOnly(['title', 'body', 'at', 'byUid'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
